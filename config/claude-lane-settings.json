{
  "permissions": {
    "allow": [
      "Edit(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote get-url:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(uv run scripts/kit_doctor.py:*)",
      "Bash(uv run scripts/devkit/kit_doctor.py:*)",
      "Bash(make test:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(gh:*)",
      "Bash(git commit:*)",
      "Bash(uv run scripts/pr_watch.py:*)",
      "Bash(uv run scripts/devkit/pr_watch.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${ADK_LANE_PUSH_HOOK:?missing lane launcher}\""
          },
          {
            "type": "command",
            "command": "python3 -I \"${ADK_LANE_PR_HOOK:?missing lane launcher}\""
          }
        ]
      }
    ]
  }
}
