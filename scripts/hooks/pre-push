#!/usr/bin/env bash
#
# Pre-push guard — the dev/* narrative-file guard (Principle #1/#2: the
# living handoff + friction-log files are cockpit-owned; a dev/* lane branch
# must never edit them directly).
#
# A lane branch (created by `scripts/dev_session.sh new`, namespaced
# `<dev_branch_prefix>/<scope>`) is told in its kickoff prompt / lane contract
# never to edit the shared narrative files — this hook turns that convention
# into a mechanism. Cockpit branches (`chore/*`, `feat/*`, hand-named PRs, …)
# are unaffected — the cockpit's own "chore: update handoff" PRs legitimately
# edit these files.
#
# Fail-open when the diff can't be computed (no local
# `origin/<protected_branch>`, e.g. an offline/shallow clone) — this is a
# lane-hygiene guard, not a security gate, so an inability to verify must never
# block an otherwise-legitimate push. It does WARN to stderr in that case: a
# guard that can never fire has to be visible, or a mis-resolved base branch
# turns the whole check into a silent no-op nobody notices.
#
# NOTE — this hook is deliberately narrow. If your project also wants a
# protected-integration-branch guard or a secrets-baseline check, add them as
# separate, independently-testable checks rather than folding them in here.
#
# Defaults below are read from config/dev-model.yaml (`paths.handoff` /
# `paths.friction_log` / `vcs.dev_branch_prefix` / `vcs.protected_branch`) via
# the kit's stdlib-only reader, scripts/lib/kitconfig.py — no third-party
# import, so the read actually happens on a stock python3 instead of quietly
# degrading to the fallback constants below on any interpreter without PyYAML.
# That mattered: a config read that fails soft is indistinguishable from one
# that succeeded, so an inert read here made the whole guard inert too.
#
# `./init.sh` installs .git/hooks/pre-push (or $(core.hooksPath)/pre-push) as a
# SHIM that `exec`s this file at its source location — deliberately, so the hook
# stays current when the engine is updated. That is also what makes the config
# read work without knowing `paths.engines`: `$0` is <root>/<engines>/hooks/pre-push,
# and kitconfig.py sits at a fixed path relative to it (../lib/kitconfig.py).
# Installing by COPYING this file into .git/hooks/ instead breaks that relative
# path (and freezes the hook body) — the read then falls back to the constants.
#
# Real bypass: `git push --no-verify`.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
CONFIG_PATH="$REPO_ROOT/config/dev-model.yaml"

# Fallback constants — used when the config read can't run at all (no config
# file, no python3, or no kitconfig.py beside this hook). Keep these in sync with
# config/dev-model.yaml's `paths.handoff` / `paths.friction_log` /
# `vcs.dev_branch_prefix` / `vcs.protected_branch` if you edit one without the
# other.
NARRATIVE_FILES=("docs/handoff.md" "docs/friction-log.md")
DEV_BRANCH_PREFIX="dev"
PROTECTED_BRANCH="main"

# This hook's own directory, so the config reader can be found at a path fixed
# relative to the ENGINE file (see the shim note in the header) rather than at a
# path that would itself have to be read from config.
HOOK_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd -P || true)"
KIT_LIB="${HOOK_DIR:+$HOOK_DIR/../lib}"

if command -v python3 >/dev/null 2>&1 && [ -f "$CONFIG_PATH" ] &&
   [ -n "${KIT_LIB:-}" ] && [ -f "$KIT_LIB/kitconfig.py" ]; then
    _config_read="$(python3 - "$CONFIG_PATH" "$KIT_LIB" <<'PY' 2>/dev/null || true
import sys

sys.path.insert(0, sys.argv[2])
try:
    from kitconfig import get, loads
except ImportError:
    sys.exit(0)
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        data = loads(fh.read())
except OSError:
    sys.exit(0)
handoff = get(data, "paths.handoff", None)
friction = get(data, "paths.friction_log", None)
prefix = get(data, "vcs.dev_branch_prefix", None)
protected = get(data, "vcs.protected_branch", None)
# Build the whole payload before emitting any of it: a partial read would leave
# the hook applying a mix of configured and fallback values.
out = []
if handoff and friction:
    out.append(str(handoff))
    out.append(str(friction))
if prefix:
    out.append("PREFIX:" + str(prefix))
if protected:
    out.append("BRANCH:" + str(protected))
print("\n".join(out))
PY
)"
    if [ -n "${_config_read:-}" ]; then
        _configured_files=()
        while IFS= read -r _line; do
            case "$_line" in
                PREFIX:*) DEV_BRANCH_PREFIX="${_line#PREFIX:}" ;;
                BRANCH:*) PROTECTED_BRANCH="${_line#BRANCH:}" ;;
                *) [ -n "$_line" ] && _configured_files+=("$_line") ;;
            esac
        done <<< "$_config_read"
        [ "${#_configured_files[@]}" -ge 2 ] && NARRATIVE_FILES=("${_configured_files[@]}")
    fi
fi

ZERO="0000000000000000000000000000000000000000"

# The integration branch the lane's diff is measured against. Configured
# (`vcs.protected_branch`), never hardcoded: on a repo whose trunk is `trunk` /
# `master` / `develop`, a hardcoded `origin/main` makes `git merge-base` fail,
# `base` come back empty, and the documented fail-open path swallow every push
# — i.e. the guard silently never fires on exactly the repos that adopted the
# kit rather than authored it.
PROTECTED_REF="origin/$PROTECTED_BRANCH"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deletions have no content to scan; a non-lane ref (cockpit branches) is
  # untouched by this check entirely.
  if [ "${local_sha:-$ZERO}" != "$ZERO" ] && [[ "${remote_ref:-}" == refs/heads/"$DEV_BRANCH_PREFIX"/* ]]; then
    base="$(git merge-base "$PROTECTED_REF" "$local_sha" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      touched="$(git diff --name-only "$base" "$local_sha" -- "${NARRATIVE_FILES[@]}" 2>/dev/null || true)"
      if [ -n "$touched" ]; then
        cat >&2 <<EOF

✗ Refusing to push ${remote_ref#refs/heads/} — a ${DEV_BRANCH_PREFIX}/* lane
  branch may not touch the cockpit-owned narrative file(s):

$(printf '    %s\n' "$touched")

  ${NARRATIVE_FILES[*]} are shared narrative files the cockpit alone edits, at
  session wrap-up. Put this lane's handoff (what shipped, lessons, deferrals)
  in the PR body instead.

  Bypass (only if you know this push is legitimate): git push --no-verify

EOF
        exit 1
      fi
    else
      # base empty (no local "$PROTECTED_REF" — offline/shallow clone, an
      # unfetched remote, or a mis-set vcs.protected_branch) → fail-open: a
      # lane-hygiene guard must never block a push it can't verify. But WARN,
      # because a permanently-inert guard is worse than a noisy one: silence
      # here is indistinguishable from "checked and clean".
      cat >&2 <<EOF

⚠ pre-push: cannot compute a merge base against ${PROTECTED_REF} — skipping the
  ${DEV_BRANCH_PREFIX}/* narrative-file guard for ${remote_ref#refs/heads/} (fail-open).
  Fetch it (git fetch origin ${PROTECTED_BRANCH}), or fix vcs.protected_branch in
  config/dev-model.yaml, so this guard can actually run.

EOF
    fi
  fi
done

exit 0
