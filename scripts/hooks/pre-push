#!/usr/bin/env bash
#
# Pre-push guard — the dev/* narrative-file guard (Principle #1/#2: the
# living handoff + friction-log files are cockpit-owned; a dev/* lane branch
# must never edit them directly).
#
# A lane branch (created by `scripts/dev_session.sh new`, namespaced
# `<dev_branch_prefix>/<scope>`) is told in its kickoff prompt / lane contract
# never to edit the shared narrative files — this hook turns that convention
# into a mechanism. Cockpit branches (`chore/*`, `feat/*`, hand-named PRs, …)
# are unaffected — the cockpit's own "chore: update handoff" PRs legitimately
# edit these files.
#
# Fail-open when the diff can't be computed (no local
# `origin/<protected_branch>`, e.g. an offline/shallow clone) — this is a
# lane-hygiene guard, not a security gate, so an inability to verify must never
# block an otherwise-legitimate push. It does WARN to stderr in that case: a
# guard that can never fire has to be visible, or a mis-resolved base branch
# turns the whole check into a silent no-op nobody notices.
#
# NOTE — this hook is deliberately narrow. If your project also wants a
# protected-integration-branch guard or a secrets-baseline check, add them as
# separate, independently-testable checks rather than folding them in here.
#
# Defaults below are read from config/dev-model.yaml (`paths.handoff` /
# `paths.friction_log` / `vcs.dev_branch_prefix` / `vcs.protected_branch`) via
# the kit's stdlib-only reader, scripts/lib/kitconfig.py — no third-party
# import, so the read actually happens on a stock python3 instead of quietly
# degrading to the fallback constants below on any interpreter without PyYAML.
# That mattered: a config read that fails soft is indistinguishable from one
# that succeeded, so an inert read here made the whole guard inert too.
#
# `./init.sh` installs .git/hooks/pre-push (or $(core.hooksPath)/pre-push) as a
# SHIM that `exec`s this file at its source location — deliberately, so the hook
# stays current when the engine is updated. That is also what makes the config
# read work without knowing `paths.engines`: `$0` is <root>/<engines>/hooks/pre-push,
# and kitconfig.py sits at a fixed path relative to it (../lib/kitconfig.py).
# Installing by COPYING this file into .git/hooks/ instead breaks that relative
# path (and freezes the hook body) — the read then falls back to the constants.
#
# Real bypass: `git push --no-verify`.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
CONFIG_PATH="$REPO_ROOT/config/dev-model.yaml"

# Fallback constants — used when the config read can't run at all (no config
# file, no python3, or no kitconfig.py beside this hook). Keep these in sync with
# config/dev-model.yaml's `paths.handoff` / `paths.friction_log` /
# `vcs.dev_branch_prefix` / `vcs.protected_branch` if you edit one without the
# other.
NARRATIVE_FILES=("docs/handoff.md" "docs/friction-log.md")
DEV_BRANCH_PREFIX="dev"
PROTECTED_BRANCH="main"

# This hook's own directory, so the config reader can be found at a path fixed
# relative to the ENGINE file (see the shim note in the header) rather than at a
# path that would itself have to be read from config.
HOOK_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd -P || true)"
KIT_LIB="${HOOK_DIR:+$HOOK_DIR/../lib}"

if command -v python3 >/dev/null 2>&1 && [ -f "$CONFIG_PATH" ] &&
   [ -n "${KIT_LIB:-}" ] && [ -f "$KIT_LIB/kitconfig.py" ]; then
    _config_read="$(python3 - "$CONFIG_PATH" "$KIT_LIB" <<'PY' 2>/dev/null || true
import sys

sys.path.insert(0, sys.argv[2])
try:
    from kitconfig import get, loads
except ImportError:
    sys.exit(0)
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        data = loads(fh.read())
except OSError:
    sys.exit(0)
handoff = get(data, "paths.handoff", None)
friction = get(data, "paths.friction_log", None)
prefix = get(data, "vcs.dev_branch_prefix", None)
protected = get(data, "vcs.protected_branch", None)
# Build the whole payload before emitting any of it: a partial read would leave
# the hook applying a mix of configured and fallback values.
out = []
if handoff and friction:
    out.append(str(handoff))
    out.append(str(friction))
if prefix:
    out.append("PREFIX:" + str(prefix))
if protected:
    out.append("BRANCH:" + str(protected))
print("\n".join(out))
PY
)"
    if [ -n "${_config_read:-}" ]; then
        _configured_files=()
        while IFS= read -r _line; do
            case "$_line" in
                PREFIX:*) DEV_BRANCH_PREFIX="${_line#PREFIX:}" ;;
                BRANCH:*) PROTECTED_BRANCH="${_line#BRANCH:}" ;;
                *) [ -n "$_line" ] && _configured_files+=("$_line") ;;
            esac
        done <<< "$_config_read"
        [ "${#_configured_files[@]}" -ge 2 ] && NARRATIVE_FILES=("${_configured_files[@]}")
    fi
fi

ZERO="0000000000000000000000000000000000000000"

# The integration branch the lane's diff is measured against. Configured
# (`vcs.protected_branch`), never hardcoded: on a repo whose trunk is `trunk` /
# `master` / `develop`, a hardcoded `origin/main` makes `git merge-base` fail,
# `base` come back empty, and the documented fail-open path swallow every push
# — i.e. the guard silently never fires on exactly the repos that adopted the
# kit rather than authored it.
PROTECTED_REF="origin/$PROTECTED_BRANCH"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deletions have no content to scan; a non-lane ref (cockpit branches) is
  # untouched by this check entirely.
  if [ "${local_sha:-$ZERO}" != "$ZERO" ] && [[ "${remote_ref:-}" == refs/heads/"$DEV_BRANCH_PREFIX"/* ]]; then
    base="$(git merge-base "$PROTECTED_REF" "$local_sha" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      touched="$(git diff --name-only "$base" "$local_sha" -- "${NARRATIVE_FILES[@]}" 2>/dev/null || true)"
      if [ -n "$touched" ]; then
        cat >&2 <<EOF

✗ Refusing to push ${remote_ref#refs/heads/} — a ${DEV_BRANCH_PREFIX}/* lane
  branch may not touch the cockpit-owned narrative file(s):

$(printf '    %s\n' "$touched")

  ${NARRATIVE_FILES[*]} are shared narrative files the cockpit alone edits, at
  session wrap-up. Put this lane's handoff (what shipped, lessons, deferrals)
  in the PR body instead.

  Bypass (only if you know this push is legitimate): git push --no-verify

EOF
        exit 1
      fi
    else
      # base empty (no local "$PROTECTED_REF" — offline/shallow clone, an
      # unfetched remote, or a mis-set vcs.protected_branch) → fail-open: a
      # lane-hygiene guard must never block a push it can't verify. But WARN,
      # because a permanently-inert guard is worse than a noisy one: silence
      # here is indistinguishable from "checked and clean".
      cat >&2 <<EOF

⚠ pre-push: cannot compute a merge base against ${PROTECTED_REF} — skipping the
  ${DEV_BRANCH_PREFIX}/* narrative-file guard for ${remote_ref#refs/heads/} (fail-open).
  Fetch it (git fetch origin ${PROTECTED_BRANCH}), or fix vcs.protected_branch in
  config/dev-model.yaml, so this guard can actually run.

EOF
    fi
  fi

  # ── Stale-manifest guard (#706) ───────────────────────────────────────────
  #
  # A SEPARATE check, per this file's header: it shares the ref loop and
  # nothing else, and it applies to EVERY branch rather than only `dev/*` —
  # the occurrences it is filed about were on `chore/*` cockpit branches.
  #
  # `kit-manifest.json` records a hash per kit-owned file, correct only for the
  # bytes present when `--generate-manifest` ran. Regenerating is a natural
  # thing to do right after the edit that made it necessary, which is exactly
  # when a later edit in the same change invalidates it. Nothing re-checks
  # between that moment and the commit, so the only report came from
  # `test_kit_repo_self_check_is_clean` in the full suite — a `make test` run or
  # a CI round trip later. The guard was never broken; this moves WHEN it
  # reports.
  #
  # Both sides are read out of the PUSHED COMMIT, not the working tree: the
  # commit is what the remote will hold and what CI will judge, and a dirty or
  # half-staged tree is exactly the state this fires in.
  if [ "${local_sha:-$ZERO}" != "$ZERO" ]; then
    if ! command -v python3 >/dev/null 2>&1; then
      # Fail-open and WARN, like the guard above: silence here is
      # indistinguishable from "checked and clean".
      cat >&2 <<EOF

⚠ pre-push: no python3 — skipping the kit-manifest staleness check for
  ${remote_ref#refs/heads/} (fail-open). A stale kit-manifest.json will surface
  later as a red test_kit_repo_self_check_is_clean instead.

EOF
    else
      _stale="$(python3 - "$local_sha" <<'PY' 2>/dev/null || true
import hashlib
import json
import subprocess
import sys

sha = sys.argv[1]


def _batch(paths):
    """Bytes of each path at the pushed commit, in ONE git process.

    An earlier version diffed against the merge base and checked only the
    changed paths, spawning a `git show` each. That carried a branch for a
    failed diff which no test could reach, and a mutation flipping its
    fallback to an empty set -- the guard silently checking nothing --
    survived the whole file. Removing the branch was cheaper than reaching
    it, and checking every recorded file is also stricter: a manifest entry
    that went stale under an earlier commit is caught here too, rather than
    waiting for the push that happens to touch it again.
    """
    if not paths:
        return {}
    done = subprocess.run(
        ["git", "cat-file", "--batch"],
        input="\n".join(f"{sha}:{p}" for p in paths).encode() + b"\n",
        capture_output=True,
    )
    if done.returncode != 0:
        return {}
    out, at, found = done.stdout, 0, {}
    for path in paths:
        nl = out.find(b"\n", at)
        if nl == -1:
            break
        header = out[at:nl]
        if header.endswith(b" missing"):
            # Recorded but not in this commit. That is the membership
            # question #47 owns, not this one.
            at = nl + 1
            continue
        try:
            size = int(header.rsplit(b" ", 1)[1])
        except (IndexError, ValueError):
            break
        found[path] = out[nl + 1 : nl + 1 + size]
        at = nl + 1 + size + 1
    return found


# Every exit prints an outcome line FIRST, so the shell can tell the three
# states apart: checked, deliberately skipped, and could-not-check. Silence
# means this program died, and the shell warns on it -- the discipline the
# no-python3 branch above already follows, and which an earlier version of
# this block broke. A manifest of `[]` or `null` is valid JSON, so it passed
# the ValueError guard and then raised AttributeError on `.get`; the wrapping
# `2>/dev/null || true` swallowed the traceback AND the exit code, leaving a
# guard that was completely inert and looked exactly like a clean check
# (panel, adversarial lens).
def _skip(reason):
    print("SKIP:" + reason)
    sys.exit(0)


done = subprocess.run(
    ["git", "cat-file", "-p", f"{sha}:kit-manifest.json"], capture_output=True
)
if done.returncode != 0:
    # A repo that declined the manifest has nothing to be stale against. This
    # is the one silent skip: it is a repository shape, not a failed read.
    _skip("no-manifest")
try:
    manifest = json.loads(done.stdout)
except ValueError:
    _skip("unreadable")
if not isinstance(manifest, dict):
    # Valid JSON, wrong shape. Named separately from `unreadable` because the
    # remedies differ and because conflating them is what hid this case.
    _skip("not-an-object")
if "kit_commit" in manifest:
    # An adopter install baseline, which `--record-install` writes and
    # `--generate-manifest` does not. There a drift means the adopter EDITED a
    # kit-owned file, which is a legitimate state, so refusing that push would
    # put the #286 bug in a new place.
    _skip("adopter-baseline")
files = manifest.get("files")
if not isinstance(files, dict):
    _skip("no-files-table")

wanted = {}
for path, record in files.items():
    want = record.get("sha256") if isinstance(record, dict) else record
    if isinstance(want, str):
        wanted[path] = want

blobs = _batch(sorted(wanted))
stale = [
    path
    for path, body in sorted(blobs.items())
    if hashlib.sha256(body).hexdigest() != wanted[path]
]
print("CHECKED")
print("\n".join(stale))
PY
)"
      _outcome="$(printf '%s\n' "${_stale:-}" | head -n 1)"
      _stale="$(printf '%s\n' "${_stale:-}" | tail -n +2)"
      case "$_outcome" in
        CHECKED|SKIP:no-manifest)
          # Checked, or a repo that has no manifest to check. Both are real
          # answers, so both stay quiet.
          ;;
        *)
          # Everything else is the check NOT having run: a manifest it could
          # not read or recognise, or -- on an EMPTY outcome -- the checker
          # itself dying. Fail-open, but never silently, because silence here
          # is indistinguishable from "checked and clean".
          cat >&2 <<EOF

⚠ pre-push: could not check kit-manifest.json for ${remote_ref#refs/heads/}
  (${_outcome:-the check produced no outcome}) — skipping the staleness check
  (fail-open). A stale kit-manifest.json will surface later as a red
  test_kit_repo_self_check_is_clean instead.

EOF
          _stale=""
          ;;
      esac
      if [ -n "${_stale:-}" ]; then
        cat >&2 <<EOF

✗ Refusing to push ${remote_ref#refs/heads/} — kit-owned file(s) differ from
  kit-manifest.json in the commit being pushed:

$(printf '    %s\n' "$_stale")

  The manifest is stale: run \`kit_doctor.py --generate-manifest\` and commit it
  with your change. Regenerate it LAST, after the final edit to a kit-owned
  file — regenerating early is what leaves it stale again.

  Bypass (only if you know this push is legitimate): git push --no-verify

EOF
        exit 1
      fi
    fi
  fi
done

exit 0
