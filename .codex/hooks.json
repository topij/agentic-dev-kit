{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/pr_followup_hook.py\" --runtime codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
